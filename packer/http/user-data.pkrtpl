#cloud-config
autoinstall:
  version: 1
  profile: minimal
  locale: en_US.UTF-8
  keyboard:
    layout: us
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  identity:
    hostname: ubuntu-template
    username: "${vm_os_username}"
    # This is the SHA-512 hash for the password "ubuntu"
    password: "$6$z8qgbsLX6LWIvd/o$SGf1Y2QCP8uGC1Lm7z6NKn8URyHEJkNH7jVat1tqea5AHrzaBXBx93Xzjql7RtdpClTgu5FZN6ubLF96X1HTI."
  user-data:
    package_upgrade: true
    packages:
      - qemu-guest-agent